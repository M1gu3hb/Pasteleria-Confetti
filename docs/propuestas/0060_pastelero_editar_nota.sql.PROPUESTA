-- =====================================================================
-- PROPUESTA — NO APLICADA. Requiere la firma de Miguel (toca aislamiento RLS).
-- 0060 — el rol `pastelero` puede EDITAR la nota de un pedido (y sólo eso)
-- ---------------------------------------------------------------------
-- PROBLEMA (verificado en producción 2026-08-09):
--   El pastelero LEE pedidos (229 filas) pero cualquier UPDATE afecta 0 filas.
--   Políticas actuales sobre public.pedidos:
--     pos_scope_pedidos            ALL    authenticated
--        USING/WITH CHECK: pos_is_admin() OR sucursal_id = pos_sucursal()
--     pos_pastelero_select_pedidos SELECT authenticated
--        USING: pos_is_pastelero()
--   El pastelero tiene sucursal_id = NULL, así que `sucursal_id = pos_sucursal()`
--   evalúa a NULL (no a TRUE) y pos_is_admin() es false → ninguna política de
--   escritura lo admite.
--
-- ORIGEN: 0037_rol_pastelero.sql (2026-06-30, commit 17a3210). Su propio
--   comentario dice "Solo lectura: no toca INSERT/UPDATE/DELETE (esos siguen
--   bajo pos_scope_pedidos)". La suposición falla por el sucursal_id NULL.
--
-- ALCANCE PROPUESTO (el MÁS ESTRECHO que resuelve lo pedido):
--   El pastelero puede modificar EXCLUSIVAMENTE `nota_voz_transcripcion`.
--   NO estado, NO precios, NO anticipo/saldo, NO sucursal_id, NO fechas.
--   RLS no sabe de columnas y el POS usa un solo rol de base (`authenticated`),
--   así que la restricción por columna se impone con un trigger BEFORE UPDATE
--   que compara OLD vs NEW y rechaza cualquier otro cambio.
--
-- REVERSIÓN: DROP TRIGGER + DROP FUNCTION + DROP POLICY (las tres líneas del
--   final). No modifica ninguna política existente, así que no abre ninguna
--   ventana sin RLS en ningún momento.
-- =====================================================================

-- 1) Permiso de escritura, acotado al pastelero.
create policy pos_pastelero_update_pedidos
  on public.pedidos
  for update
  to authenticated
  using      ((select public.pos_is_pastelero()))
  with check ((select public.pos_is_pastelero()));

-- 2) Candado por columna: si el que escribe es pastelero, sólo puede cambiar
--    la transcripción. Cualquier otra diferencia aborta el UPDATE.
create or replace function public.guard_pastelero_solo_nota()
returns trigger
language plpgsql
security definer
set search_path = public, pg_temp
as $$
begin
  -- Sólo aplica al pastelero. Caja/administrador/dueño no se ven afectados.
  if not (select public.pos_is_pastelero()) then
    return new;
  end if;
  -- Comparación fila-a-fila ignorando la única columna permitida.
  if to_jsonb(new) - 'nota_voz_transcripcion'
     is distinct from
     to_jsonb(old) - 'nota_voz_transcripcion' then
    raise exception
      'PASTELERO_SOLO_NOTA: este usuario únicamente puede editar la nota del pedido.'
      using errcode = '42501';
  end if;
  return new;
end;
$$;

create trigger trg_guard_pastelero_solo_nota
  before update on public.pedidos
  for each row execute function public.guard_pastelero_solo_nota();

-- EVIDENCIA A PRODUCIR ANTES DE FIRMAR (sobre datos reales, en transacciones
-- REVERTIDAS, sin dejar escritura):
--   [1] pastelero: UPDATE de nota_voz_transcripcion  -> 1 fila.
--   [2] pastelero: UPDATE de estado                  -> excepción 42501.
--   [3] pastelero: UPDATE de precio/anticipo         -> excepción 42501.
--   [4] pastelero: INSERT y DELETE                   -> siguen rechazados (0 filas).
--   [5] caja de Xochimilco: sigue viendo y escribiendo SOLO su sucursal.
--   [6] administrador y dueño: sin cambios en lo que ven ni en lo que escriben.
--   [7] anon: sin acceso nuevo.

-- REVERSIÓN:
--   drop trigger if exists trg_guard_pastelero_solo_nota on public.pedidos;
--   drop function if exists public.guard_pastelero_solo_nota();
--   drop policy if exists pos_pastelero_update_pedidos on public.pedidos;
