# Supabase (staging). En Vercel se configuran como Environment Variables.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Fase 4 — password fijo de las cuentas TERMINAL (Opción A). Debe coincidir con
# el crypt() de supabase/migrations/0015_fase4_cuentas_terminal.sql.
VITE_TERMINAL_PASSWORD=POS-TERMINAL-CONFETTI

# (Legado Fase 2/3) Sesión staging temporal. Ya NO se usa en Fase 4 (el bootstrap
# de sesión es la cuenta terminal). Se pueden dejar para referencia o borrar.
VITE_STAGING_AUTH_EMAIL=staging-pos@confetti.local
VITE_STAGING_AUTH_PASSWORD=cambia_esto
